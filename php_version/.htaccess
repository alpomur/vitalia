# Apache Rewrite Rules
# .htaccess dosyası olarak kullanın

RewriteEngine On
RewriteBase /

# Force HTTPS (opsiyonel)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Var olan dosyalara dokunma
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# config.php'yi koru
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# PHP error reporting (development için)
# php_flag display_errors on
# php_value error_reporting E_ALL
